{
  "name": "tcgdash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dashboard locale per il registro partite Pokemon TCG: inserimento match, winrate per settimana, matchup e note",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "ingest": "python scripts/ingest_xlsx.py",
    "serve": "node scripts/serve.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "db": "python scripts/excel_db.py stato",
    "db:pulisci": "python scripts/excel_db.py pulisci"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
